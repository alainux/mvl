{
  "name": "minimum-viable-language",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A typed framework for compositional subsets of natural languages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "node scripts/serve.mjs",
    "pages": "npm run check",
    "review:export": "npm run build && node scripts/export-linguistic-review.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@playwright/test": "^1.55.0"
  }
}
